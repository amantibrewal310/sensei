# Planning, teaching, and panel layout.
ANTHROPIC_API_KEY=

# Narration (text-to-speech). Output only — no microphone is ever requested.
OPENAI_API_KEY=

# --- Everything below is for the auth and spend-cap work. See docs/setup.md. ---
# Nothing here is read yet, so the app still runs with these blank. `lib/env.ts`
# starts requiring each one as the task that uses it lands.

# Neon Postgres. Two URLs, and they are not interchangeable: the app runs
# through the pooler, migrations must not. The pooled host has "-pooler" in it.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js. Generate with: npx auth secret
# This one is not a credential from anywhere — it is a random string that signs
# the session cookie. A different value in production than locally is correct.
AUTH_SECRET=

# Google OAuth client (Web application). Auth.js finds the Google provider by
# these exact names, so do not rename them to GOOGLE_*.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Approval emails. ADMIN_EMAIL is who gets told someone is waiting, and is the
# only account allowed into /admin.
RESEND_API_KEY=
ADMIN_EMAIL=

# Set only in CI. `next build` imports every route to collect page data, so
# without this a build with no secrets fails on config rather than on code.
# SKIP_ENV_VALIDATION=1
