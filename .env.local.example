# Planning, teaching, and panel layout.
ANTHROPIC_API_KEY=

# Narration (text-to-speech). Output only — no microphone is ever requested.
OPENAI_API_KEY=

# --- Auth and the spend cap. See docs/setup.md. ---
# `lib/env.ts` starts requiring each one as the task that uses it lands, so a
# variable is blank here only while nothing reads it. Required today: everything
# down to ADMIN_EMAIL. Still optional: RESEND_API_KEY.

# Neon Postgres. Two URLs, and they are not interchangeable: the app runs
# through the pooler, migrations must not. The pooled host has "-pooler" in it.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js. Generate with: npx auth secret
# This one is not a credential from anywhere — it is a random string that signs
# the session cookie. A different value in production than locally is correct.
AUTH_SECRET=

# Google OAuth client (Web application). Auth.js finds the Google provider by
# these exact names, so do not rename them to GOOGLE_*.
#
# The console offers these as a JSON download. Copy the two values out and keep
# the file outside the repo — it holds the secret in plain text, and
# `client_secret_*.json` is in .gitignore because a browser will happily save it
# straight into your working directory.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who is admin: approved automatically on sign-in, and the only account allowed
# into /admin. Matched case-insensitively against the address Google returns, so
# it must be an account you can actually sign in with — nothing else can grant
# the first approval.
ADMIN_EMAIL=

# Approval emails — who gets told that someone is waiting.
RESEND_API_KEY=

# tldraw license key — the free tier's key, requested at tldraw.dev, keeps the
# "Made with tldraw" watermark. Not a secret: it is domain-locked and ships in
# the client bundle, which is why it is the one NEXT_PUBLIC_ variable in the
# app (see components/Board.tsx). Optional in development; without it in
# PRODUCTION the SDK unmounts the canvas on a timer and the lesson dies with it.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Set only in CI. `next build` imports every route to collect page data, so
# without this a build with no secrets fails on config rather than on code.
# SKIP_ENV_VALIDATION=1
